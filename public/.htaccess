# Apartments Rašpolić – Plus Hosting (Apache)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

RewriteEngine On
# HTTPS i bez www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://apartments-raspolic.com%{REQUEST_URI} [R=301,L]

# Korijen: jezik preglednika (hr, de, it, inače en)
RewriteCond %{HTTP:Accept-Language} ^(hr|bs|sr|sl) [NC]
RewriteRule ^$ /hr/ [R=302,L]
RewriteCond %{HTTP:Accept-Language} ^de [NC]
RewriteRule ^$ /de/ [R=302,L]
RewriteCond %{HTTP:Accept-Language} ^it [NC]
RewriteRule ^$ /it/ [R=302,L]
RewriteRule ^$ /en/ [R=302,L]

# Skrivene datoteke i podaci nikad s weba
RewriteRule (^|/)\. - [F]
<FilesMatch "\.(json\.tmp|log|sql|md|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Astro imena datoteka sadrže hash – mogu se čuvati godinu dana
  <FilesMatch "^.*\.[0-9a-zA-Z_-]{8,}\.(css|js|webp|avif|jpg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
