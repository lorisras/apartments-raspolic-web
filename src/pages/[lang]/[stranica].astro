---
import Osnovni from '../../layouts/Osnovni.astro';
import ObrazacUpita from '../../components/ObrazacUpita.astro';
import KontaktGumbi from '../../components/KontaktGumbi.astro';
import podaci from '../../data/apartmani.json';
import { JEZICI, PUT, t, url, alternative } from '../../i18n/ui.js';

export function getStaticPaths() {
  return JEZICI.flatMap((lang) => ['upit', 'impressum', 'privatnost', 'pravila'].map((vrsta) => ({ params: { lang, stranica: PUT[vrsta][lang] }, props: { vrsta } })));
}
const { vrsta } = Astro.props;
const jezik = Astro.params.lang;
const T = t(jezik);
const naslov = { upit: T.upit_naslov, impressum: T.impressum, privatnost: T.privatnost, pravila: T.pravila }[vrsta];
const k = podaci.kuca;
const vlasnici = k.vlasnici || [];
const veznik = { hr: ' i ', en: ' and ', de: ' und ', it: ' e ' }[jezik];
const zamijeni = (txt) => txt.replace('%a', k.adresa).replace('%e', k.email).replace('%v', vlasnici.map((v) => `${v.ime} (${T.oib} ${v.oib})`).join(veznik));
---
<Osnovni jezik={jezik} naslov={`${naslov} – Apartments Rašpolić`} alternative={alternative((j) => url.stranica(j, vrsta))}>
  <div class="omot stranica">
    {vrsta === 'upit' && (
      <div class="dva">
        <div class="stog">
          <p class="nadnaslov">{T.upit}</p>
          <h1>{T.upit_naslov}</h1>
          <p class="tekst-2">{T.upit_tekst}</p>
          <KontaktGumbi />
          {(podaci.kuca.telefon || podaci.kuca.email) && <p class="mala">{[podaci.kuca.telefon, podaci.kuca.email].filter(Boolean).join(' · ')}</p>}
        </div>
        <ObrazacUpita jezik={jezik} />
      </div>
    )}
    {vrsta === 'impressum' && (
      <div class="stog uski">
        <h1>{T.impressum}</h1>
        <p><b>Apartments Rašpolić</b><br>{k.adresa}<br>{[k.telefon, k.email].filter(Boolean).join(' · ')}</p>
        <h2>{T.iznajmljivaci}</h2>
        {vlasnici.map((v) => <p>{v.ime}<br>{v.adresa}<br>{T.oib}: {v.oib}</p>)}
        <ul class="popis-ap">
          {podaci.apartmani.map((a) => <li><b>{a.naziv}</b> · {T.iznajmljivac}: {a.vlasnik} · {T.kategorizacija}: {T.zvjezdice(a.zvjezdice)}{a.registracijskiBroj && <> · {T.reg_broj}: {a.registracijskiBroj}</>}</li>)}
        </ul>
        <h2>{T.prigovor_naslov}</h2>
        <p class="tekst-2">{zamijeni(T.prigovor_tekst)}</p>
      </div>
    )}
    {vrsta === 'privatnost' && (
      <div class="stog uski">
        <h1>{T.privatnost}</h1>
        {T.privatnost_odsjeci.map(([n, txt]) => <section><h2>{n}</h2><p class="tekst-2">{zamijeni(txt)}</p></section>)}
      </div>
    )}
    {vrsta === 'pravila' && (
      <div class="stog uski">
        <h1>{T.pravila}</h1>
        <p class="tekst-2 veliki">{T.pravila_uvod}</p>
        {T.pravila_odsjeci.map(([n, stavke]) => <section><h2>{n}</h2><ul class="tockice jedan">{stavke.map((x) => <li>{x}</li>)}</ul></section>)}
      </div>
    )}
  </div>
</Osnovni>

<style>
  .stranica { padding-top: 48px; }
  .dva { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: start; }
  .stog { display: flex; flex-direction: column; gap: 16px; }
  .uski { max-width: 720px; }
  .popis-ap { padding-left: 20px; display: grid; gap: 6px; }
  .uski h2 { font-size: 24px; margin-top: 12px; }
  .uski section { display: grid; gap: 10px; }
  .tockice.jedan { grid-template-columns: 1fr; }
  .veliki { font-size: 19px; }
</style>
